apiVersion: kpt.dev/v1
kind: Kptfile
metadata:
  name: grafana
  annotations:
    config.kubernetes.io/local-config: "true"
info:
  description: kpt package for provisioning Grafana on Google Managed Prometheus
  keywords:
    - GCP
    - GKE
    - Google Managed Prometheus
    - Grafana
pipeline:
  mutators:
    - image: ghcr.io/kptdev/krm-functions-catalog/set-namespace:v0.4
      configMap:
        namespace: grafana
    - image: ghcr.io/kptdev/krm-functions-catalog/set-labels:v0.2
      configMap:
        app.kubernetes.io/managed-by: gcp-cloud-build-deploy
        backstage.io/kubernetes-id: backstage-component-id
    - image: ghcr.io/kptdev/krm-functions-catalog/apply-setters:v0.2
      configMap:
        cert-name: grafana.example.com
        db_user: grafana@project-id.iam
        domain: example.com
        grafana_admin_group: admin@google.com
        instance_connection_name: project-id:region:instance-name
    - image: ghcr.io/kptdev/krm-functions-catalog/set-annotations:v0.1
      name: set-grafana-service-account-annotations
      configMap:
        iam.gke.io/gcp-service-account: grafana@monitoring-scope-project-id.iam.gserviceaccount.com
      selectors:
        - kind: ServiceAccount
          name: grafana
  validators:
    - image: ghcr.io/kptdev/krm-functions-catalog/kubeconform:v0.1
      configMap:
        ignore_missing_schemas: "true"
