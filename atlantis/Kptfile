apiVersion: kpt.dev/v1
kind: Kptfile
metadata:
  name: atlantis
  annotations:
    config.kubernetes.io/local-config: "true"
info:
  description: >-
    Kubernetes Deployment of Atlantis on GKE. Atlantis is a tool for
    collaborating on Terraform through GitHub, GitLab, and Bitbucket.
  site: https://www.runatlantis.io/
  emails:
    - devnull@broadinstitute.org
  keywords:
    - atlantis
    - terraform
    - GKE
    - GCP
pipeline:
  mutators:
    - image: ghcr.io/kptdev/krm-functions-catalog/set-image:v0.1
      configMap:
        name: us-east4-docker.pkg.dev/bits-gke-clusters/bits/atlantis:latest
        newName: ghcr.io/runatlantis/atlantis
        newTag: latest
    - image: ghcr.io/kptdev/krm-functions-catalog/set-namespace:v0.4
      configPath: package-context.yaml
    - image: ghcr.io/kptdev/krm-functions-catalog/set-labels:v0.2
      configMap:
        app: atlantis
        app.kubernetes.io/managed-by: gcp-cloud-build-deploy
        backstage.io/kubernetes-id: atlantis
        environment: prod
    - image: ghcr.io/kptdev/krm-functions-catalog/apply-setters:v0.2
      configPath: package-context.yaml
  validators:
    - image: ghcr.io/kptdev/krm-functions-catalog/kubeconform:v0.1
      configMap:
        ignore_missing_schemas: "true"
